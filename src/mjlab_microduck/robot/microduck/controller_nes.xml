<mujoco model="microduck_nes_controller">
    <compiler angle="radian" autolimits="true"/>

    <!-- Simulation-first controller with four independent vertical keys. -->
    <default>
        <default class="nes_button_joint">
            <joint type="slide" axis="0 0 1" limited="true" range="-0.002 0"
                   stiffness="1200" damping="2.0" springref="0"
                   armature="0.00002"/>
        </default>
        <default class="nes_button">
            <geom type="box" size="0.006 0.005 0.003"
                  friction="1.6 0.02 0.002" condim="3" priority="2"
                  solref="0.005 1" solimp="0.98 0.999 0.0005"/>
        </default>
    </default>

    <worldbody>
      <body name="controller_root">
        <geom name="dpad_housing" type="box" pos="-0.007 0.043 0.004"
              size="0.038 0.033 0.004" rgba="0.025 0.030 0.045 1"
              contype="0" conaffinity="0"/>
        <geom name="ab_housing" type="box" pos="-0.006 -0.041 0.004"
              size="0.034 0.027 0.004" rgba="0.025 0.030 0.045 1"
              contype="0" conaffinity="0"/>

        <!-- Fixed frames double as per-foot anchor references. -->
        <body name="dpad_platform" pos="-0.007 0.043 0.007">
            <!-- Neutral rest is 2 mm above the unpressed keys. A sole must
                 leave this rest and move over one key before it can press. -->
            <geom name="dpad_neutral_support" type="box" pos="0 0 0.005"
                  size="0.007 0.006 0.003" rgba="0.18 0.22 0.30 1"
                  friction="1.6 0.02 0.002" condim="3" priority="2"/>
            <body name="dpad_left_key" pos="0 0.016 0">
                <joint name="passive_dpad_left" class="nes_button_joint"/>
                <inertial pos="0 0 0" mass="0.010" diaginertia="8e-7 8e-7 8e-7"/>
                <geom name="dpad_left_surface" class="nes_button" pos="0 0 0.003"
                      rgba="0.25 0.72 1 1"/>
            </body>
            <body name="dpad_right_key" pos="0 -0.016 0">
                <joint name="passive_dpad_right" class="nes_button_joint"/>
                <inertial pos="0 0 0" mass="0.010" diaginertia="8e-7 8e-7 8e-7"/>
                <geom name="dpad_right_surface" class="nes_button" pos="0 0 0.003"
                      rgba="0.25 0.72 1 1"/>
            </body>
        </body>

        <body name="ab_platform" pos="-0.006 -0.041 0.007">
            <geom name="ab_neutral_support" type="box" pos="0 0 0.005"
                  size="0.007 0.006 0.003" rgba="0.22 0.17 0.22 1"
                  friction="1.6 0.02 0.002" condim="3" priority="2"/>
            <body name="button_a_key" pos="0.018 0 0">
                <joint name="passive_button_a" class="nes_button_joint"/>
                <inertial pos="0 0 0" mass="0.010" diaginertia="8e-7 8e-7 8e-7"/>
                <geom name="button_a_surface" class="nes_button" pos="0 0 0.003"
                      rgba="0.95 0.18 0.20 1"/>
            </body>
            <body name="button_b_key" pos="-0.018 0 0">
                <joint name="passive_button_b" class="nes_button_joint"/>
                <inertial pos="0 0 0" mass="0.010" diaginertia="8e-7 8e-7 8e-7"/>
                <geom name="button_b_surface" class="nes_button" pos="0 0 0.003"
                      rgba="0.95 0.64 0.12 1"/>
            </body>
        </body>
      </body>
    </worldbody>
</mujoco>
